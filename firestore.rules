rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // FUNÇÕES AUXILIARES DE VALIDAÇÃO
    // =========================================================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Data no formato YYYY-MM-DD (o valor é exibido na tela e usado em IDs de elementos)
    function isValidData(v) {
      return v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    // ID curto gerado pelo app (séries de lançamentos, cartões)
    function isValidIdCurto(v) {
      return v is string && v.matches('^[A-Za-z0-9_-]{1,40}$');
    }

    // Campos opcionais de série (recorrente/parcelado) e cartão de crédito
    function isValidExtrasTransacao(d) {
      return
        (!('serieId' in d) || isValidIdCurto(d.serieId)) &&
        (!('recorrente' in d) || d.recorrente is bool) &&
        (!('parcela' in d) || (d.parcela is int && d.parcela >= 1 && d.parcela <= 120)) &&
        (!('parcelas' in d) || (d.parcelas is int && d.parcelas >= 1 && d.parcelas <= 120)) &&
        (!('cartaoId' in d) || isValidIdCurto(d.cartaoId)) &&
        (!('dataCompra' in d) || (d.dataCompra is string && isValidData(d.dataCompra)));
    }

    // Orçamento: valor opcional por categoria de gasto
    function isValidValorOrcamento(m, k) {
      return !(k in m) || (m[k] is number && m[k] > 0 && m[k] <= 10000000);
    }

    function isValidOrcamentos(m) {
      return m is map &&
        m.keys().hasOnly(['Alimentação', 'Contas da Casa', 'Saúde', 'Transporte', 'Lazer',
                          'Roupas/Beleza', 'Assinaturas', 'Educação', 'Outros']) &&
        isValidValorOrcamento(m, 'Alimentação') && isValidValorOrcamento(m, 'Contas da Casa') &&
        isValidValorOrcamento(m, 'Saúde') && isValidValorOrcamento(m, 'Transporte') &&
        isValidValorOrcamento(m, 'Lazer') && isValidValorOrcamento(m, 'Roupas/Beleza') &&
        isValidValorOrcamento(m, 'Assinaturas') && isValidValorOrcamento(m, 'Educação') &&
        isValidValorOrcamento(m, 'Outros');
    }

    // Valida campos de uma transação (criação)
    function isValidTransacao() {
      let d = request.resource.data;
      return
        // UID obrigatório e pertence ao solicitante
        d.uid is string &&
        d.uid == request.auth.uid &&

        // Tipo: apenas 'income' ou 'expense'
        d.type is string &&
        d.type in ['income', 'expense'] &&

        // Descrição: string, não vazia, máximo 300 chars
        d.description is string &&
        d.description.size() > 0 &&
        d.description.size() <= 300 &&

        // Valor: número positivo, máximo razoável (R$ 10 milhões)
        d.amount is number &&
        d.amount > 0 &&
        d.amount <= 10000000 &&

        // Categoria: string, não vazia, máximo 100 chars
        d.category is string &&
        d.category.size() > 0 &&
        d.category.size() <= 100 &&

        // Data: string no formato YYYY-MM-DD (10 chars)
        d.date is string &&
        isValidData(d.date) &&

        // pago: booleano opcional (status de pago/consolidado)
        (!('pago' in d) || d.pago is bool) &&

        isValidExtrasTransacao(d) &&

        // Nenhum campo extra permitido (previne injeção de dados)
        d.keys().hasOnly(['uid', 'type', 'description', 'amount', 'category', 'date', 'pago',
                          'serieId', 'recorrente', 'parcela', 'parcelas', 'cartaoId', 'dataCompra']);
    }

    // Valida campos de uma transação (atualização)
    function isValidTransacaoUpdate() {
      let d = request.resource.data;
      return
        isValidTransacao() &&
        // UID NÃO pode mudar — imutável após criação
        d.uid == resource.data.uid;
    }

    // Valida campos de um investimento (criação)
    function isValidInvestimento() {
      let d = request.resource.data;
      return
        d.uid is string &&
        d.uid == request.auth.uid &&

        d.description is string &&
        d.description.size() > 0 &&
        d.description.size() <= 300 &&

        d.amount is number &&
        d.amount > 0 &&
        d.amount <= 10000000 &&

        d.category is string &&
        d.category.size() > 0 &&
        d.category.size() <= 100 &&

        d.date is string &&
        isValidData(d.date) &&

        // pago: booleano opcional
        (!('pago' in d) || d.pago is bool) &&

        d.keys().hasOnly(['uid', 'description', 'amount', 'category', 'date', 'pago']);
    }

    // Valida campos de um investimento (atualização)
    function isValidInvestimentoUpdate() {
      let d = request.resource.data;
      return
        isValidInvestimento() &&
        // UID NÃO pode mudar
        d.uid == resource.data.uid;
    }

    // Valida perfil do usuário
    function isValidPerfil(userId) {
      let d = request.resource.data;
      return
        // Garante que está atualizando o próprio perfil
        request.auth.uid == userId &&

        // Nome: string opcional, máximo 100 chars
        (!('nome' in d) || (d.nome is string && d.nome.size() <= 100)) &&

        // Telefone: string opcional, máximo 30 chars
        (!('telefone' in d) || (d.telefone is string && d.telefone.size() <= 30)) &&

        // Foto: string opcional, imagem JPEG/PNG/WebP em base64, máximo 100KB (~136KB base64)
        (!('foto' in d) || d.foto == null || (d.foto is string && d.foto.size() <= 140000
          && d.foto.matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$'))) &&

        // sobraAutomatica: booleano opcional
        (!('sobraAutomatica' in d) || d.sobraAutomatica is bool) &&

        // modoEscuro: booleano opcional
        (!('modoEscuro' in d) || d.modoEscuro is bool) &&

        // Orçamento por categoria, cartões de crédito e metas de economia
        (!('orcamentos' in d) || isValidOrcamentos(d.orcamentos)) &&
        (!('cartoes' in d) || (d.cartoes is list && d.cartoes.size() <= 10)) &&
        (!('metas' in d) || (d.metas is list && d.metas.size() <= 30)) &&

        // Apenas campos permitidos
        d.keys().hasOnly(['nome', 'telefone', 'foto', 'sobraAutomatica', 'modoEscuro',
                          'orcamentos', 'cartoes', 'metas']);
    }

    // =========================================================
    // REGRAS PARA TRANSAÇÕES
    // =========================================================
    match /transacoes_app/{documentId} {
      // Leitura: apenas o dono do documento
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      // Criação: autenticado, dados válidos, UID bate
      allow create: if isAuthenticated() && isValidTransacao();

      // Atualização: autenticado, dono, dados válidos, UID imutável
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && isValidTransacaoUpdate();

      // Exclusão: apenas o dono
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // =========================================================
    // REGRAS PARA INVESTIMENTOS
    // =========================================================
    match /investimentos_app/{documentId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;

      allow create: if isAuthenticated() && isValidInvestimento();

      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && isValidInvestimentoUpdate();

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // =========================================================
    // REGRAS PARA PERFIL DO USUÁRIO
    // =========================================================
    match /usuarios_app/{userId} {
      // Leitura: apenas o próprio usuário
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Criação: apenas o próprio usuário, dados válidos
      allow create: if isAuthenticated()
                    && request.auth.uid == userId
                    && isValidPerfil(userId);

      // Atualização: apenas o próprio usuário, dados válidos
      allow update: if isAuthenticated()
                    && request.auth.uid == userId
                    && isValidPerfil(userId);

      // Exclusão: apenas o próprio usuário (opção "Excluir minha conta" — LGPD)
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================
    // REGRA CATCH-ALL: Negar tudo que não foi explicitamente
    // autorizado acima
    // =========================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
