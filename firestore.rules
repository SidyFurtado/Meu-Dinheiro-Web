rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Regras para transações
    match /transacoes_app/{documentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid && (request.method == 'delete' || request.resource.data.uid == request.auth.uid);
    }

    // Regras para investimentos
    match /investimentos_app/{documentId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid && (request.method == 'delete' || request.resource.data.uid == request.auth.uid);
    }

    // Regras para perfis de usuários e configurações gerais
    match /usuarios_app/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
